rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isVerifiedThaparUser() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.matches('.*@thapar\\.edu');
    }

    match /users/{uid} {
      allow read, create, update: if isVerifiedThaparUser() && request.auth.uid == uid;
    }

    match /projects/{projectId} {
      allow read: if isVerifiedThaparUser();
      allow create: if isVerifiedThaparUser()
        && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isVerifiedThaparUser()
        && resource.data.ownerId == request.auth.uid;
    }
  }
}
